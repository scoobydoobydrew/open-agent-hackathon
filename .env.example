# LLM: Meterless Nightshift is the primary provider (a local OpenAI-compatible runtime, default http://127.0.0.1:8088/v1).
# Add the NVIDIA key in Nightshift's Providers tab, NOT here.
# On the machine where Nightshift runs nothing else is needed: the runtime token is read from its own file
# (Windows: %LOCALAPPDATA%/ai.meterless.runtime/proxy-token). Otherwise give ONE of these:
# NIGHTSHIFT_CONNECT_LINK=http://127.0.0.1:8088/connect#k=your_key      (Nightshift's Connect link: base URL and key)
# NIGHTSHIFT_TOKEN=your_nightshift_runtime_token                         (METERLESS_TOKEN works too)
# NIGHTSHIFT_TOKEN_FILE=/path/to/proxy-token
# If your Meterless account gave you an address and a key instead: METERLESS_BASE_URL=... and METERLESS_API_KEY=...
# NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
# NIGHTSHIFT_APP=verified-knockout-agent
# NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NEMOTRON_THINKING=0

# Optional fallback, used only when Nightshift is not reachable (labelled "NVIDIA direct (fallback)" everywhere):
# NVIDIA_API_KEY=your_key_here

# Data layer: Zetaris gateway (the web UI port, NOT 8888). Without credentials the agent falls back to data/*.csv
# and says so in every report.
ZETARIS_GATEWAY_URL=http://localhost:3000
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASS=your_zetaris_password
ZETARIS_DB=open_agent

# Run with no network call at all (no Zetaris, no Nightshift, no NVIDIA): local files, symbolic search, recorded replays.
# SAMPLE_MODE=true
