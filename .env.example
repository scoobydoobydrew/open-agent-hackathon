# LLM: NVIDIA Nemotron over REST (https://integrate.api.nvidia.com)
NVIDIA_API_KEY=your_key_here
# Optional. Thinking is off by default because it did not finish within 16000 tokens on our prompts.
# NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NEMOTRON_THINKING=0

# Data layer: Zetaris gateway (the web UI port, NOT 8888). Without credentials the agent falls back to data/*.csv
# and says so in every report.
ZETARIS_GATEWAY_URL=http://localhost:3000
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASS=your_zetaris_password
ZETARIS_DB=open_agent

# Optional: send the LLM calls through the Meterless OpenAI-compatible runtime instead of NVIDIA directly.
# Both must be set; when they are, they take priority over NVIDIA_API_KEY.
# METERLESS_BASE_URL=https://...
# METERLESS_API_KEY=your_meterless_runtime_token
